{
  "name": "jev-2048",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Serve on *.workers.dev only. Per-version preview URLs are off so old versions do not stay reachable.
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "vars": {
    "JEV_ENDPOINT": "https://api.typesafe.ai/v1/systemone",
    "DAILY_LIMIT": "20000"
  },
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "Budget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Budget"] }],
  "ratelimits": [
    { "name": "MOVE_LIMITER", "namespace_id": "2048", "simple": { "limit": 150, "period": 10 } }
  ]
}
